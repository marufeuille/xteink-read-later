OPENAI_API_KEY=
OPENROUTER_API_KEY=
CLIP_TOKEN=
OPDS_USERNAME=
OPDS_PASSWORD=
# Deploy smoke only. SHA-256 hex digests, not the raw token or password.
# Empty disables smoke auth. Do not commit values. See docs/deploy-smoke.md.
SMOKE_CLIP_TOKEN_SHA256=
SMOKE_OPDS_BASIC_SHA256=
# Optional Cronitor Job telemetry. Empty skips pings. Not the Access HTTP checks.
# Names: docs/health-checks.md. Do not put real values in git.
CRONITOR_API_KEY=
CRONITOR_FEED_COLLECT_MONITOR_KEY=
CRONITOR_CLIP_MONITOR_KEY=
CRONITOR_DAILY_DIGEST_MONITOR_KEY=
# Optional. Used only by `npm run translate:bakeoff`. Not a Worker secret.
# PLAMO_API_KEY=
