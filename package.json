{
  "name": "xteink-read-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "generate-types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:live": "E2E_LIVE=1 vitest run --config vitest.e2e.config.ts",
    "clip:status": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli/clip-status.ts",
    "translate:bakeoff": "TRANSLATE_BAKEOFF=1 vitest run --config vitest.e2e.config.ts test/e2e/translate-bakeoff.live.test.ts",
    "pr-risk:github": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/pr-risk/cli.ts github",
    "pr-risk:replay": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/pr-risk/cli.ts replay",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hono": "^4.9.8",
    "node-html-parser": "^9.0.4",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.37.1"
  }
}
