{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xteink-read-later",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Paid Workers CPU budget. Free plan 10ms is not enough for extract + EPUB.
  "limits": {
    "cpu_ms": 30000
  },
  "workers_dev": true,
  // Public origin baked into digest QR codes. Not a secret. Cron has no request URL.
  // Remove this var and redeploy to publish digests without QR links.
  "vars": {
    "PUBLIC_ORIGIN": "https://xteink-read-later.marufeuille.workers.dev"
  },
  // wrangler dev だけ。本番の管理画面は Zero Trust のパス単位 Access（Google）で保護する。
  // Worker 全体には掛けない（OPDS / POST /clip を壊す）。
  "access": {
    "dev": {
      "aud": "xteink-read-later-dev",
      "identity": {
        "email": "dev@localhost"
      }
    }
  },
  "r2_buckets": [
    {
      "binding": "ARTICLES",
      "bucket_name": "xteink-read-later-articles"
    }
  ],
  // Local/dev placeholder. Deploy job looks up or creates the named D1 database
  // and rewrites this id before `wrangler deploy`. See .github/scripts/ensure-d1-database.sh.
  "d1_databases": [
    {
      "binding": "CANDIDATES",
      "database_name": "xteink-read-later-candidates",
      "database_id": "00000000-0000-4000-8000-000000000073",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CLIP_QUEUE",
        "queue": "xteink-read-later-clip"
      },
      {
        "binding": "FEED_QUEUE",
        "queue": "xteink-read-later-feed"
      },
      {
        "binding": "DIGEST_QUEUE",
        "queue": "xteink-read-later-digest"
      }
    ],
    "consumers": [
      {
        "queue": "xteink-read-later-clip",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        // No DLQ; recover stuck jobs with POST /clip.
        "max_retries": 3
      },
      {
        "queue": "xteink-read-later-feed",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        // No DLQ; recover failed collections with POST /sources/:id/collect.
        "max_retries": 3
      },
      {
        "queue": "xteink-read-later-digest",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        // No DLQ; recover failed digests with POST /digest.
        "max_retries": 3
      }
    ]
  },
  "triggers": {
    // Daily feed collection at 04:00 Asia/Tokyo (UTC 19:00). Keep in sync with FEED_COLLECT_CRON.
    // Daily digest at 06:00 Asia/Tokyo (UTC 21:00). Keep in sync with DAILY_DIGEST_CRON.
    "crons": ["0 19 * * *", "0 21 * * *"]
  }
}
