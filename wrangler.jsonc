{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xteink-read-later",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Paid Workers CPU budget. Free plan 10ms is not enough for extract + EPUB.
  "limits": {
    "cpu_ms": 30000
  },
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "ARTICLES",
      "bucket_name": "xteink-read-later-articles"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CLIP_QUEUE",
        "queue": "xteink-read-later-clip"
      }
    ],
    "consumers": [
      {
        "queue": "xteink-read-later-clip",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        // No DLQ; recover stuck jobs with POST /clip.
        "max_retries": 3
      }
    ]
  }
}
