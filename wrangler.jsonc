{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xteink-read-later",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "ARTICLES",
      "bucket_name": "xteink-read-later-articles"
    }
  ]
}
